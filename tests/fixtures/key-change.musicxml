      <note><pitch><step>F</step><alter>1</alter><octave>3</octave></pitch><duration>2</duration><type>half</type></note>
      <note><pitch><step>B</step><octave>3</octave></pitch><duration>2</duration><type>half</type></note>
    </measure>
    <measure number="4">
      <note><pitch><step>C</step><alter>1</alter><octave>3</octave></pitch><duration>2</duration><type>half</type></note>
      <attributes><clef><sign>F</sign><line>4</line></clef></attributes>
      <note><pitch><step>D</step><octave>2</octave></pitch><duration>2</duration><type>half</type></note>
